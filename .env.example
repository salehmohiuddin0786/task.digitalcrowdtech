# TaskDigitalCrowd SaaS - Environment Template
# Digital Crowd Technologies

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database
DATABASE_URL="mysql://username:password@localhost:3306/taskdigitalcrowd_db"

# JWT Authentication
JWT_ACCESS_SECRET="replace_with_strong_access_token_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_strong_refresh_token_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend / CORS
CLIENT_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Timezone
DEFAULT_TIMEZONE="Asia/Kolkata"

# Storage (Future Evidence S3/Cloudinary)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Redis (BullMQ for recurring tasks / reminders)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
